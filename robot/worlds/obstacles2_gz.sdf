<?xml version="1.0" ?>
<!-- Mundo para Gazebo Fortress (Ignition Gazebo 6). Versión ampliada de
     obstacles_gz.sdf para demostrar Nav2: recinto de 12 x 9 m (~3x el área del
     original de 6 x 6), un pasillo central de 1.6 m, dos habitaciones al norte
     y un área abierta al sur, con obstáculos de dos tipos (cajas y cilindros).

     Dimensionado para el robot real: robot_radius 0.25, inflation_radius 0.30
     (local) / 0.40 (global). Pasillo de 1.6 m -> franja libre de inflación de
     1.0 m. Puertas de 1.2/1.4 m -> franja libre de 0.4/0.6 m. El robot spawnea
     en el origen, que cae dentro del pasillo.

     Self-contained: no usa modelos de Fuel, así que carga offline. -->
<sdf version="1.8">
  <world name="obstacles2">

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Recinto cerrado de 12 x 9 m, paredes de 0.3 m de alto -->
    <model name="walls">
      <static>true</static>
      <link name="wall_north">
        <pose>0 4.5 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.1 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.1 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="wall_south">
        <pose>0 -4.5 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.1 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.1 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="wall_east">
        <pose>6 0 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 9.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 9.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="wall_west">
        <pose>-6 0 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 9.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 9.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Paredes interiores: pasillo este-oeste de 1.6 m (y de -0.8 a 0.8).
         Pared norte del pasillo (y = 0.8) con dos puertas de 1.2 m en
         x = -3.5 y x = 3.5, una por habitación. -->
    <model name="corridor_walls">
      <static>true</static>
      <link name="north_west_seg">
        <pose>-5.05 0.8 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.9 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.9 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="north_mid_seg">
        <pose>0 0.8 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>5.8 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.8 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="north_east_seg">
        <pose>5.05 0.8 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.9 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.9 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <!-- Pared sur del pasillo (y = -0.8) con DOS puertas de 1.4 m, en x = -4.0 y x = 0.
           Las dos puertas son lo que convierte el mundo en un grafo con ciclo:
           pasillo -> puerta(-4.0) -> area sur -> puerta(0) -> pasillo. Sin ese ciclo
           no se puede probar loop closure, porque nunca volves a un lugar ya mapeado
           desde otra direccion. Perimetro del circuito: ~15 m. -->
      <link name="south_west_seg">
        <pose>-5.35 -0.8 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.3 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.3 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="south_mid_seg">
        <pose>-2.0 -0.8 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.6 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.6 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="south_east_seg">
        <pose>3.35 -0.8 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>5.3 0.1 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.3 0.1 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <!-- Divisoria entre habitación 1 (oeste) y habitación 2 (este) -->
      <link name="room_divider">
        <pose>0 2.65 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 3.7 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.7 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Habitación 1 (noroeste): dos cajas y un cilindro -->
    <model name="box_1">
      <static>true</static>
      <pose>-4.5 3.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-1.6 1.9 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_1">
      <static>true</static>
      <pose>-3.0 3.7 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Habitación 2 (noreste): dos cilindros y una caja -->
    <model name="cylinder_2">
      <static>true</static>
      <pose>1.8 2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_3">
      <static>true</static>
      <pose>4.5 3.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_3">
      <static>true</static>
      <pose>2.6 3.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.7 0.7 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.5</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Área abierta al sur: columnas y una caja, para planificar rodeos -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-3.0 -2.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>3.0 -2.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_4">
      <static>true</static>
      <pose>0 -3.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.5</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
